#!/usr/bin/env php
<?php

function includeAutoload(): bool
{
    if (isset($GLOBALS['_composer_autoload_path']) && file_exists($GLOBALS['_composer_autoload_path'])) {
        require $GLOBALS['_composer_autoload_path'];
        return true;
    }

    $paths = [
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ];

    foreach ($paths as $file) {
        if (file_exists($file)) {
            require $file;
            return true;
        }
    }

    return false;
}

if (!includeAutoload()) {
    fwrite(STDERR, "Error: Composer autoload.php not found.\n");
    fwrite(STDERR, "Run 'composer install' or make sure the package is installed globally.\n");
    exit(1);
}

use Iwh3n\Tgram\Console\ConsoleApplication;

$app = new ConsoleApplication();
$app->registerCommands();
$app->run();
